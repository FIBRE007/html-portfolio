{
    "name": "RFID + Face Attendance",
    "short_name": "Attendance",
    "description": "Parent-facing attendance app: RFID + face verified school check-ins with notification history.",
    "start_url": "../public/attendance-dashboard.html",
    "scope": "../public/",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#f5f7fa",
    "theme_color": "#2563eb",
    "icons": [
        {
            "src": "icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-512-maskable.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Kiosk check-in",
            "short_name": "Kiosk",
            "url": "../public/attendance-app.html"
        }
    ]
}
